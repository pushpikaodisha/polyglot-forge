    {
      "id": "ep-users-list",
      "name": "User Directory API",
      "method": "GET",
      "path": "/v1/users",
      "statusCode": 200,
      "delayMs": 0,
      "enabled": true,
      "tags": [
        "users",
        "crm"
      ],
      "description": "Returns paginated list of active platform users with dynamic mock data",
      "headers": {
        "Content-Type": "application/json",
        "X-Total-Count": "100",
        "X-Page": "1"
      },
      "body": "{\n  \"status\": \"success\",\n  \"page\": 1,\n  \"total\": 100,\n  \"data\": [\n    {\n      \"id\": \"{{uuid}}\",\n      \"name\": \"{{name}}\",\n      \"email\": \"{{email}}\",\n      \"company\": \"{{company}}\",\n      \"status\": \"active\",\n      \"createdAt\": \"{{timestamp}}\"\n    },\n    {\n      \"id\": \"{{uuid}}\",\n      \"name\": \"{{name}}\",\n      \"email\": \"{{email}}\",\n      \"company\": \"{{company}}\",\n      \"status\": \"active\",\n      \"createdAt\": \"{{timestamp}}\"\n    },\n    {\n      \"id\": \"{{uuid}}\",\n      \"name\": \"{{name}}\",\n      \"email\": \"{{email}}\",\n      \"company\": \"{{company}}\",\n      \"status\": \"pending\",\n      \"createdAt\": \"{{timestamp}}\"\n    }\n  ]\n}",
      "createdAt": "2026-11-21T05:21:15.448Z",
      "updatedAt": "2026-11-21T05:21:15.448Z"
    },
    {
      "id": "ep-user-detail",
      "name": "Get User By ID",
      "method": "GET",
      "path": "/v1/users/:id",
      "statusCode": 200,
      "delayMs": 25,
      "enabled": true,
      "tags": [
        "users"
      ],
      "description": "Fetches individual user details reflecting the requested URL param ID",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\n  \"status\": \"success\",\n  \"user\": {\n    \"id\": \"{{req.params.id}}\",\n    \"name\": \"{{name}}\",\n    \"email\": \"{{email}}\",\n    \"role\": \"admin\",\n    \"avatar\": \"https://api.dicebear.com/7.x/bottts/svg?seed={{req.params.id}}\",\n    \"registeredAt\": \"{{timestamp}}\"\n  }\n}",
      "createdAt": "2026-11-21T05:21:15.448Z",
      "updatedAt": "2026-11-21T05:21:15.448Z"
    },
    {
      "id": "ep-auth-login",
      "name": "Authentication Login",
      "method": "POST",
      "path": "/v1/auth/login",
      "statusCode": 200,
      "delayMs": 50,
      "enabled": true,
      "tags": [
        "auth",
        "security"
      ],
      "description": "Simulates user authentication, issuing token and session credentials",
      "headers": {
        "Content-Type": "application/json",
        "Cache-Control": "no-store"
      },
      "body": "{\n  \"token_type\": \"Bearer\",\n  \"access_token\": \"forge_jwt_{{uuid}}\",\n  \"expires_in\": 3600,\n  \"user\": {\n    \"username\": \"{{req.body.username || 'developer'}}\",\n    \"role\": \"superadmin\",\n    \"lastLogin\": \"{{timestamp}}\"\n  }\n}",
      "createdAt": "2026-11-21T05:21:15.448Z",
      "updatedAt": "2026-11-21T05:21:15.448Z"
    },
    {
      "id": "ep-create-order",
      "name": "Place Commerce Order",
      "method": "POST",
      "path": "/v1/orders",
      "statusCode": 201,
      "delayMs": 80,
      "enabled": true,
      "tags": [
        "ecommerce",
        "checkout"
      ],
      "description": "Accepts cart payload and creates verified order with transaction ID",
      "headers": {
        "Content-Type": "application/json",
        "Location": "/mock/v1/orders/ord-{{uuid}}"
      },
      "body": "{\n  \"orderId\": \"ORD-{{randomInt(100000, 999999)}}\",\n  \"status\": \"CONFIRMED\",\n  \"paymentStatus\": \"PAID\",\n  \"amount\": \"{{randomFloat(29.99, 499.99, 2)}}\",\n  \"currency\": \"USD\",\n  \"processedAt\": \"{{timestamp}}\",\n  \"trackingNumber\": \"TRK-{{uuid}}\"\n}",
